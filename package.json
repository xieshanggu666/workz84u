{
  "name": "exam-system",
  "version": "2.0.0",
  "private": true,
  "description": "在线考试与题库管理系统（FastAPI + Vue3 + TypeScript）",
  "scripts": {
    "setup": "npm --prefix frontend install",
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "python3 -m uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "test": "pytest tests/ -v"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
